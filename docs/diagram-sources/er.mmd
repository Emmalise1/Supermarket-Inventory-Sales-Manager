        varchar full_name
        varchar role
        bigint branch_id FK
        boolean active
    }
    CATEGORIES {
        bigint id PK
        varchar name UK
    }
    SUPPLIERS {
        bigint id PK
        varchar name
        boolean active
    }
    PRODUCTS {
        bigint id PK
        varchar barcode UK
        varchar name
        bigint category_id FK
        bigint supplier_id FK
        bigint branch_id FK
        decimal price
        int quantity_in_stock
        int low_stock_threshold
        boolean active
    }
    SALES {
        bigint id PK
        varchar sale_number UK
        bigint branch_id FK
        bigint cashier_id FK
        decimal total_amount
        int item_count
        varchar status
